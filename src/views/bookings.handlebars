<h1>{{title}}</h1>

{{#if bookings.length}}
<table id="bookings-table">
  <thead>
    <tr>
      <th>#</th>
      <th>Cliente</th>
      <th>Email</th>
      <th>Fecha</th>
      <th>Hora</th>
      <th>Estado</th>
      <th>Detalles</th>
    </tr>
  </thead>
  <tbody>
    {{#each bookings}}
    <tr data-booking-id="{{this._id}}">
      <td>{{this._id}}</td>
      <td><strong>{{this.clientName}}</strong></td>
      <td>{{this.clientEmail}}</td>
      <td>{{this.date}}</td>
      <td>{{this.time}}</td>
      <td>
        {{#if (eq this.status "pendiente")}}
          <span class="badge badge-warning">Pendiente</span>
        {{else if (eq this.status "confirmada")}}
          <span class="badge badge-success">Confirmada</span>
        {{else if (eq this.status "cancelada")}}
          <span class="badge badge-danger">Cancelada</span>
        {{else}}
          <span class="badge">{{this.status}}</span>
        {{/if}}
      </td>
      <td>
        <a href="/views/booking/{{this._id}}" class="btn btn-primary">Ver detalle</a>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
<p class="pagination-info">Mostrando {{bookings.length}} de {{meta.total}} registros</p>

<!-- ===== CONTROLES DE PAGINACIÓN ===== -->
<nav id="pagination" class="pagination-controls">
  <ul class="pagination-list">
    <!-- Botón Anterior -->
    {{#if meta.hasPrevPage}}
      <li><a href="{{paginationUrl (sub meta.page 1) queryParams}}" class="btn-page btn-prev">&laquo; Anterior</a></li>
    {{else}}
      <li><span class="btn-page btn-prev disabled" aria-disabled="true">&laquo; Anterior</span></li>
    {{/if}}

    <!-- Números de página -->
    {{#each meta.pageNumbers}}
      {{#if this.isCurrent}}
        <li><span class="btn-page active">{{this.number}}</span></li>
      {{else if this.isDots}}
        <li><span class="btn-page dots">...</span></li>
      {{else}}
        <li><a href="{{paginationUrl this.number queryParams}}" class="btn-page">{{this.number}}</a></li>
      {{/if}}
    {{/each}}

    <!-- Botón Siguiente -->
    {{#if meta.hasNextPage}}
      <li><a href="{{paginationUrl (add meta.page 1) queryParams}}" class="btn-page btn-next">Siguiente &raquo;</a></li>
    {{else}}
      <li><span class="btn-page btn-next disabled" aria-disabled="true">Siguiente &raquo;</span></li>
    {{/if}}
  </ul>
</nav>
<!-- ===== FIN CONTROLES DE PAGINACIÓN ===== -->

{{else}}
<p>No hay reservas registradas actualmente.</p>
{{/if}}